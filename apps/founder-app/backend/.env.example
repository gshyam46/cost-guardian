# Copy to backend/.env and fill in real values. Never commit the real .env file.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=cost_guardian_db

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- LLM providers (used by the Founder Niche Discovery agent pipeline) ---
# At least one of GOOGLE_GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY is required.
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Langfuse (trace/cost capture -- see docs/ARCHITECTURE.md) ---
# Free project: https://cloud.langfuse.com
# Without these, the app still runs but produces no traces, and the Guardian worker
# has nothing to analyze.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
