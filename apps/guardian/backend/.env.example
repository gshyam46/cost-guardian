# Copy to .env and fill in. Never commit the real .env.
MONGO_URL=
GUARDIAN_DB_NAME=cost_guardian
GUARDIAN_PORT=8001
GUARDIAN_CORS_ORIGINS=http://localhost:3001

# Any non-empty secret. Guardian returns 503 on data endpoints until this is set,
# rather than serving unauthenticated.
GUARDIAN_API_KEY=

# The Langfuse project Guardian reads telemetry from. Guardian never talks to the
# monitored application directly -- only to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# How often the worker polls Langfuse. 60 is the deployment default; drop to 15 for a
# live demo so the dashboard reacts while you are still watching it.
GUARDIAN_POLL_INTERVAL_SECONDS=60
