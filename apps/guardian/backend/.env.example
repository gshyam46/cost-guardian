# Copy to .env and fill in. Never commit the real .env.
# Must point to a transaction-capable replica set. Standalone Mongo is unsupported.
MONGO_URL=
GUARDIAN_DB_NAME=cost_guardian
GUARDIAN_PORT=8001
GUARDIAN_CORS_ORIGINS=http://localhost:3001

# langfuse preserves the existing reader. direct accepts Guardian JSON events
# without Langfuse, requires OIDC below and a fresh isolated project database.
# One source mode per database; never delete bindings to switch modes.
# See docs/CAPTURE.md and examples/native-capture/README.md.
GUARDIAN_CAPTURE_MODE=langfuse

# api_key is the local development compatibility mode. Named team access uses oidc.
GUARDIAN_AUTH_MODE=api_key
# In api_key mode, empty configuration returns 503 rather than unauthenticated data.
GUARDIAN_API_KEY=

# OIDC mode ignores GUARDIAN_API_KEY. Configure all required fields before switching.
# Production frontend/API must share GUARDIAN_PUBLIC_URL, an HTTPS origin.
# Register callback: https://your-guardian-host/api/guardian/auth/callback
# Confidential client: authorization_code + client_secret_basic + PKCE S256 + RS256.
# See docs/IDENTITY.md for safe setup, fixed project binding and local development.
GUARDIAN_OIDC_ISSUER=
GUARDIAN_OIDC_CLIENT_ID=
GUARDIAN_OIDC_CLIENT_SECRET=
GUARDIAN_PUBLIC_URL=
# Leave unset to use GUARDIAN_PUBLIC_URL (do not set an empty value in OIDC mode).
# GUARDIAN_UI_ORIGIN=https://your-guardian-host
GUARDIAN_ORGANIZATION_ID=
GUARDIAN_PROJECT_ID=
GUARDIAN_ENVIRONMENT=
GUARDIAN_PROJECT_NAME=
# Replace with exact verified issuer subjects, not emails. At least one owner.
GUARDIAN_OIDC_MEMBERS_JSON=[]
GUARDIAN_ALLOW_INSECURE_LOCAL_AUTH=false

# Used only in langfuse mode. Direct capture needs no Langfuse/provider keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# v2 is the supported Cloud/self-hosted v4+ reader. v1 is explicit legacy
# compatibility for self-hosted v3; no automatic fallback occurs.
LANGFUSE_READ_API=v2

# Development polling default. Worker and dashboard share source request capacity;
# verify endpoint/plan quotas and ingestion delay before reducing this interval.
GUARDIAN_POLL_INTERVAL_SECONDS=60
# Stable connection identity; retain through key rotation. Existing incremental
# databases require an explicit cutover; see docs/INGESTION.md.
GUARDIAN_CONNECTION_ID=primary

# Optional Slack delivery in named OIDC mode. Treat this URL as a secret.
# Set identically in API, ingestion and separate notifications.worker processes.
# Owner must send a test and enable delivery in Setup. See docs/NOTIFICATIONS.md.
GUARDIAN_SLACK_WEBHOOK_URL=
