            "display_type": "line"
          }
        ]
      },
      "layout": { "x": 4, "y": 2, "width": 4, "height": 2 }
    },
    {
      "id": 6,
      "definition": {
        "title": "Agent latency distribution (ms)",
        "title_size": "16",
        "title_align": "left",
        "time": {},
        "type": "heatmap",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:llm.latency_ms{*} by {agent}"
              }
            ]
          }
        ]
      },
      "layout": { "x": 8, "y": 2, "width": 4, "height": 2 }
    },
    {
      "id": 7,
      "definition": {
        "title": "Total tokens used by agent",
        "title_size": "16",
        "title_align": "left",
        "time": {},
        "type": "toplist",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "sum:llm.tokens_used{*} by {agent}",
                "aggregator": "sum"
              }
            ],
            "response_format": "scalar",
            "formulas": [
              { "formula": "query1" }
            ],
            "sort": {
              "count": 10,
              "order_by": [
                { "type": "formula", "index": 0, "order": "desc" }
              ]
            }
          }
        ],
        "style": {
          "display": {
            "type": "stacked",
            "legend": "automatic"
          }
        }
      },
      "layout": { "x": 0, "y": 4, "width": 4, "height": 2 }
    },
    {
      "id": 8,
      "definition": {
        "title": "Total cost per user (USD)",
        "title_size": "16",
        "title_align": "left",
        "time": {},
        "type": "bar_chart",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "sum:llm.cost_usd{*} by {user}",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              { "formula": "query1" }
            ],
            "sort": {
              "count": 10,
              "order_by": [
                { "type": "formula", "index": 0, "order": "desc" }
              ]
            },
            "response_format": "scalar"
          }
        ],
        "style": {
          "display": {
            "type": "stacked",
            "legend": "automatic"
          }
        }
      },
      "layout": { "x": 4, "y": 4, "width": 4, "height": 2 }
    },
    {
      "id": 9,
      "definition": {
        "title": "Overall reliability (last 5 min)",
        "title_size": "16",
        "title_align": "left",
        "time": {},
        "type": "query_value",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "name": "query1",
                "data_source": "metrics",
                "query": "avg:llm.reliability_score{*}.rollup(avg, 300)",
                "aggregator": "avg"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 2,
        "timeseries_background": { "type": "area" }
      },
      "layout": { "x": 8, "y": 4, "width": 4, "height": 2 }
    }
  ],
  "template_variables": [],
  "layout_type": "ordered",
  "notify_list": [],
  "reflow_type": "fixed",
  "pause_auto_refresh": false
}
