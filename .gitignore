# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/
.venv_check/

# Verification script output (may contain trace ids from a real project, never secrets)
tools/verify_mvp_report.json
tools/build_baseline_report.json
tools/reports/

# Real credentials -- never commit. Each app has a tracked .env.example template.
# NOTE: backend/.env was tracked in commits 6b20601/bbb6820 before this rule existed;
# any key present in those commits must be treated as compromised and rotated.
.env
**/.env
.env.*
*.env
!**/.env.example

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/
# Windows may create this literal path when a sanitized test environment lacks SystemDrive.
/apps/guardian/backend/%SystemDrive%/

# Mobile development
android-sdk/ 
# Test caches
.pytest_cache/
