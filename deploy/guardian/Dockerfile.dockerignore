# Allowlist for `docker build -f deploy/guardian/Dockerfile .`.
# Dockerfile-specific ignore rules take precedence over a root .dockerignore.
**
!apps/
!apps/guardian/
!apps/guardian/backend/
!apps/guardian/backend/*.py
!apps/guardian/backend/requirements.txt
!apps/guardian/backend/requirements.constraints.txt
!apps/guardian/backend/api/
!apps/guardian/backend/api/*.py
!apps/guardian/backend/capture/
!apps/guardian/backend/capture/*.py
!apps/guardian/backend/deployment/
!apps/guardian/backend/deployment/*.py
!apps/guardian/backend/guardian/
!apps/guardian/backend/guardian/*.py
!apps/guardian/backend/guardian/detectors/
!apps/guardian/backend/guardian/detectors/*.py
!apps/guardian/backend/identity/
!apps/guardian/backend/identity/*.py
!apps/guardian/backend/notifications/
!apps/guardian/backend/notifications/*.py
!apps/guardian/backend/policies/
!apps/guardian/backend/policies/*.py
!apps/guardian/frontend/
!apps/guardian/frontend/package.json
!apps/guardian/frontend/package-lock.json
!apps/guardian/frontend/craco.config.js
!apps/guardian/frontend/jsconfig.json
!apps/guardian/frontend/postcss.config.js
!apps/guardian/frontend/tailwind.config.js
!apps/guardian/frontend/public/
!apps/guardian/frontend/public/index.html
!apps/guardian/frontend/src/
!apps/guardian/frontend/src/**/
!apps/guardian/frontend/src/**/*.js
!apps/guardian/frontend/src/**/*.jsx
!apps/guardian/frontend/src/**/*.css
# Defense in depth for future additions inside otherwise allowed source folders.
**/.env
**/.env.*
**/*.env
**/.git
**/.git/**
**/.cache
**/.cache/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.map
**/*.pem
**/*credentials.json
**/*token.json*
