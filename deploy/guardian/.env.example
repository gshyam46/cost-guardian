# Public configuration and secret FILE PATHS only; never put secret contents here.
# Copy to a private env file and pass it explicitly with docker compose --env-file.
GUARDIAN_IMAGE=cost-guardian:local
GUARDIAN_DB_NAME=cost_guardian
GUARDIAN_PUBLIC_URL=https://guardian.example.com
GUARDIAN_OIDC_ISSUER=https://identity.example.com
GUARDIAN_OIDC_CLIENT_ID=guardian
GUARDIAN_ORGANIZATION_ID=example-org
GUARDIAN_PROJECT_ID=example-project
GUARDIAN_PROJECT_NAME=Example Project
GUARDIAN_ENVIRONMENT=production
GUARDIAN_CONNECTION_ID=primary
GUARDIAN_POLL_INTERVAL_SECONDS=10
GUARDIAN_HOST_PORT=8001
GUARDIAN_TRUSTED_PROXY_IPS=
# Mount only these individual files; UID10001 must be able to read them.
# Mongo content must be an authenticated TLS replica-set URI.
# Membership content must include an exact issuer subject with the owner role.
GUARDIAN_MONGO_URL_SECRET_FILE=/absolute/private/path/mongo-url.txt
GUARDIAN_OIDC_CLIENT_SECRET_FILE=/absolute/private/path/oidc-client-secret.txt
GUARDIAN_OIDC_MEMBERS_JSON_FILE=/absolute/private/path/oidc-members.json
# Needed only with compose.notifications.yaml.
GUARDIAN_SLACK_WEBHOOK_URL_SECRET_FILE=/absolute/private/path/slack-webhook.txt
